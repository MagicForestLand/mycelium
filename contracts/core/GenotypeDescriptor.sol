pragma solidity ^0.8.24;

import {MetadataEncoder} from "./MetadataEncoder.sol";
import {IArtBank} from "./IArtBank.sol";
import {SVGConstants, SVGHeaderStore} from "./generated/SVGConstants.sol";

/// @notice Immutable-art SVG and metadata descriptor used by MyceliumFriends.
/// @dev Banks are fixed at construction and decode compressed vector bead runs.
/// MyceliumFriends stores the uint48 genotype assigned to each sequential NFT ID.
contract GenotypeDescriptor {
    error InvalidBank(uint256 layer);
    error InvalidGenotype(uint256 layer, uint8 index);
    error InvalidEditionIndex();

    IArtBank[6] public banks;
    uint16[6] public traitCounts;
    uint256 public immutable combinations;
    MetadataEncoder public immutable encoder;
    address public immutable headerStore;

    constructor(address[6] memory artBanks, MetadataEncoder metadataEncoder) {
        require(address(metadataEncoder).code.length != 0, "Invalid encoder");
        encoder = metadataEncoder;
        headerStore = address(new SVGHeaderStore());
        uint256 total = 1;
        for (uint256 i; i < 6; ++i) {
            if (artBanks[i].code.length == 0) revert InvalidBank(i);
            IArtBank bank = IArtBank(artBanks[i]);
            uint256 size = bank.count();
            if (size == 0 || size > 256) revert InvalidBank(i);
            banks[i] = bank;
            traitCounts[i] = uint16(size);
            total *= size;
        }
        combinations = total;
    }

    function renderSVG(uint48 genotype) public view returns (string memory) {
        // Assemble once instead of repeatedly copying the growing SVG prefix.
        return string.concat(
            _header(),
            _part(genotype, 0),
            _part(genotype, 1),
            _part(genotype, 2),
            _part(genotype, 3),
            _part(genotype, 4),
            _part(genotype, 5),
            SVGConstants.CLOSE
        );
    }

    function _part(uint48 genotype, uint256 position) private view returns (string memory) {
        uint256 layer = SVGConstants.renderLayer(position);
        string memory part = banks[layer].part(_index(genotype, layer));
        string memory open = SVGConstants.compositionOpen(genotype, layer);
        return bytes(open).length == 0 ? part : string.concat(open, part, "</g>");
    }

    function tokenURI(uint256 tokenId, uint48 genotype) external view returns (string memory) {
        return encoder.tokenURI(tokenId, renderSVG(genotype), attributes(genotype), fieldNotes(genotype));
    }

    /// @notice JSON-safe field notes from the same immutable traits as the image.
    function fieldNotes(uint48 genotype) public view returns (bytes memory notes) {
        for (uint256 i; i < 6; ++i) {
            uint8 index = _index(genotype, i);
            notes = abi.encodePacked(notes, "\\n\\n", SVGConstants.layerName(i),
                " - ", banks[i].label(index), ": ", banks[i].description(index));
        }
    }

    function attributes(uint48 genotype) public view returns (bytes memory attrs) {
        for (uint256 i; i < 6; ++i) {
            // Bank labels are the fixed ASCII labels generated by build.mjs.
            attrs = abi.encodePacked(attrs, i == 0 ? "" : ",",
                '{"trait_type":"', SVGConstants.layerName(i),
                '","value":"', banks[i].label(_index(genotype, i)), '"}');
        }
    }

    /// @notice Enumerates combinations deterministically. NOT random minting.
    function genotypeForIndex(uint256 index) external view returns (uint48 genotype) {
        if (index >= combinations) revert InvalidEditionIndex();
        for (uint256 i; i < 6; ++i) {
            genotype |= uint48(index % traitCounts[i]) << uint48(i * 8);
            index /= traitCounts[i];
        }
    }

    function _index(uint48 genotype, uint256 layer) internal view returns (uint8 index) {
        index = uint8(genotype >> (layer * 8));
        if (index >= traitCounts[layer]) revert InvalidGenotype(layer, index);
    }

    function _header() private view returns (string memory) {
        bytes memory data = new bytes(SVGConstants.HEADER_LENGTH);
        SVGHeaderStore store = SVGHeaderStore(headerStore);
        for (uint256 i; i < SVGConstants.HEADER_PAGES; ++i) {
            (address source, uint256 length, uint256 offset) = store.page(i);
            assembly ("memory-safe") { extcodecopy(source, add(add(data, 32), offset), 0, length) }
        }
        return string(data);
    }
}
