{
  "name": "mycelium",
  "version": "0.0.0-private",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "build": "node tooling/build/build.mjs && node tooling/build/build-web3.mjs",
    "build:production": "node tooling/build/build.mjs && node tooling/build/build-web3.mjs",
    "build:beads": "node tooling/build/build-beads.mjs && npm run build",
    "dev": "./tooling/dev/dev.sh",
    "dev:restart": "./tooling/dev/dev.sh restart",
    "dev:status": "./tooling/dev/dev.sh status",
    "dev:stop": "./tooling/dev/dev.sh stop",
    "start": "node tooling/dev/serve.mjs",
    "test": "node tooling/build/build.mjs && node --test",
    "test:chain": "node tooling/testing/check-chain.mjs",
    "test:royalties": "node tooling/testing/check-royalties.mjs",
    "test:allowlist": "node tooling/testing/check-allowlist.mjs",
    "test:header": "node tooling/testing/check-header-verification.mjs",
    "test:artwork-lock": "node tooling/verification/artwork-release-lock.mjs",
    "test:browser": "node tooling/testing/check-web3.mjs",
    "test:core": "node tooling/testing/check-chain.mjs --core-only",
    "release:prepare": "node tooling/release/prepare-release.mjs",
    "release:verify": "node tooling/verification/verify-release.mjs",
    "release:preflight": "node tooling/verification/release-preflight.mjs",
    "release:mainnet": "node tooling/release/mainnet-release.mjs",
    "release:ledger-sign": "node tooling/release/ledger-sign-intent.mjs",
    "release:fork": "node tooling/verification/run-mainnet-fork.mjs",
    "release:health": "node tooling/verification/live-health.mjs",
    "release:export-repo": "node tooling/release/export-public-repository.mjs",
    "release:export-capsule": "node tooling/release/export-source-capsule.mjs",
    "release:architecture-equivalence": "node tooling/verification/architecture-equivalence.mjs generate",
    "release:verify-architecture-equivalence": "node tooling/verification/architecture-equivalence.mjs verify",
    "release:prepare-ci": "node tooling/testing/prepare-ci-rehearsal.mjs",
    "release:verify-safe": "node tooling/verification/verify-safe-policy.mjs",
    "release:verification": "node tooling/verification/source-verification.mjs",
    "test:catalog": "node tooling/testing/check-catalog-core.mjs",
    "build:web3": "node tooling/build/build-web3.mjs",
    "local:chain": "node tooling/dev/local-chain.mjs",
    "local:deploy": "node tooling/dev/deploy-local.mjs",
    "test:mint-protection": "npm run build:web3 && node tooling/testing/check-protected-mint-browser.mjs",
    "test:allowlist-browser": "node tooling/testing/check-allowlist-browser.mjs",
    "test:mint-ux": "node tooling/testing/check-mint-ux.mjs",
    "test:spiral": "node --test tests/apps/web/unit/spiral-geometry.test.mjs && node tooling/testing/check-spiral.mjs",
    "test:snapshot-startup": "node tooling/testing/check-snapshot-startup.mjs",
    "test:redteam": "node tooling/testing/redteam.mjs",
    "verify:solidity-input": "node tooling/verification/prepare-static-analysis.mjs",
    "check:clean": "node tooling/verification/check-clean-tree.mjs",
    "check:references": "node tooling/verification/check-references.mjs",
    "check:web-static": "node tooling/verification/check-web-static.mjs",
    "test:web-quality": "node tooling/testing/check-web-quality.mjs",
    "test:m4": "npm run check:web-static && npm run export:site -- deployments/core/ethereum/mainnet.json apps/web/config/mainnet-staging-site.json && npm run test:web-quality && npm run test:mint-protection",
    "test:m4:screen-reader": "MANUAL_A11Y=1 npm run test:mint-protection",
    "test:mint-visual": "MANUAL_VISUAL=1 npm run test:mint-protection && MANUAL_VISUAL=1 npm run test:allowlist-browser",
    "export:site": "node tooling/build/build.mjs && node tooling/build/export-site.mjs"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "ganache": "7.9.2",
    "puppeteer-core": "25.16.0",
    "solc": "0.8.37"
  },
  "dependencies": {
    "@reown/appkit": "1.8.24",
    "@reown/appkit-adapter-ethers": "1.8.24",
    "ethers": "6.17.0"
  },
  "overrides": {
    "follow-redirects": "1.16.1",
    "tmp": "0.2.7",
    "zod": "4.6.7"
  }
}
